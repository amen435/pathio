generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                String             @id @default(uuid())
  fullName          String
  email             String             @unique
  password          String
  memberNumber      Int                @unique
  isVerified        Boolean            @default(false)
  role              Role               @default(USER)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  onboardingAnswers OnboardingAnswer[]
  roadmap           Roadmap?
}

model WaitlistEntry {
  id        String   @id @default(uuid())
  email     String   @unique
  createdAt DateTime @default(now())
}

model OnboardingAnswer {
  id            String    @id @default(dbgenerated("uuid_generate_v4()::text"))
  userId        String    @map("user_id")
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  goal          String
  goalCategory  String    @map("goal_category") @db.VarChar(50)
  currentLevel  String    @map("current_level") @db.VarChar(20)
  hoursPerWeek  Int       @map("hours_per_week")
  preferredDays String[]  @default([]) @map("preferred_days")
  preferredTime String    @map("preferred_time") @db.VarChar(20)
  timezone      String    @default("UTC") @db.VarChar(50)
  previousStop  String?   @map("previous_stop")
  motivation    String?
  completedAt   DateTime? @map("completed_at")
  createdAt     DateTime  @default(now()) @map("created_at")

  @@index([userId], map: "idx_onboarding_answers_user_id")
  @@index([completedAt], map: "idx_onboarding_answers_completed_at")
  @@map("onboarding_answers")
}

model Roadmap {
  id          String        @id @default(dbgenerated("uuid_generate_v4()::text"))
  userId      String        @unique @map("user_id")
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String        @db.VarChar(255)
  totalWeeks  Int           @map("total_weeks")
  currentWeek Int           @default(1) @map("current_week")
  phase       String        @db.VarChar(50)
  calendarId  String?       @map("calendar_id") @db.VarChar(255)
  generatedAt DateTime      @default(now()) @map("generated_at")
  weeks       RoadmapWeek[]

  @@map("roadmaps")
}

model RoadmapWeek {
  id                String    @id @default(dbgenerated("uuid_generate_v4()::text"))
  roadmapId         String    @map("roadmap_id")
  roadmap           Roadmap   @relation(fields: [roadmapId], references: [id], onDelete: Cascade)
  weekNumber        Int       @map("week_number")
  phase             String    @db.VarChar(100)
  topicName         String    @map("topic_name") @db.VarChar(255)
  whyItMatters      String    @map("why_it_matters")
  explanation       String
  videoUrl          String?   @map("video_url") @db.VarChar(500)
  videoTitle        String?   @map("video_title") @db.VarChar(255)
  notebookCode      String?   @map("notebook_code")
  notebookLanguage  String?   @map("notebook_language") @db.VarChar(20)
  miniProject       String    @map("mini_project")
  starterCode       String?   @map("starter_code")
  estimatedHours    Int       @map("estimated_hours")
  difficulty        String    @db.VarChar(20)
  encouragementNote String?   @map("encouragement_note")
  mobileFillBlanks  Json?     @map("mobile_fill_blanks")
  status            String    @default("LOCKED") @db.VarChar(20)
  calendarEventId   String?   @map("calendar_event_id") @db.VarChar(255)
  startedAt         DateTime? @map("started_at")
  completedAt       DateTime? @map("completed_at")
  createdAt         DateTime  @default(now()) @map("created_at")

  @@unique([roadmapId, weekNumber], map: "roadmap_weeks_roadmap_id_week_number_key")
  @@index([roadmapId], map: "idx_roadmap_weeks_roadmap_id")
  @@index([weekNumber], map: "idx_roadmap_weeks_week_number")
  @@index([status], map: "idx_roadmap_weeks_status")
  @@map("roadmap_weeks")
}

enum Role {
  USER
  ADMIN
}
